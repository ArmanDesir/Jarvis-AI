# Runtime
RIGHTJOB_ENVIRONMENT=local
RIGHTJOB_LOG_LEVEL=INFO
RIGHTJOB_BUILD_VERSION=dev

# API
RIGHTJOB_API_HOST=127.0.0.1
RIGHTJOB_API_PORT=8000
RIGHTJOB_API_DATABASE_REQUIRED=false

# Worker
RIGHTJOB_WORKER_ID=worker-local
RIGHTJOB_WORKER_POLL_SECONDS=30

# Database (local, non-secret default)
RIGHTJOB_DATABASE_ENABLED=false
RIGHTJOB_DATABASE_URL=postgresql+psycopg://rightjob:rightjob@localhost:5432/rightjob

# Storage (accepted interface; adapter not implemented)
RIGHTJOB_STORAGE_ENABLED=false
RIGHTJOB_STORAGE_ENDPOINT=
RIGHTJOB_STORAGE_REGION=

# Identity proof gate (disabled; no adapter implemented)
RIGHTJOB_IDENTITY_ENABLED=false
RIGHTJOB_IDENTITY_ADAPTER=disabled

# AI proof gate (disabled; no adapter implemented)
RIGHTJOB_AI_ENABLED=false
RIGHTJOB_AI_ADAPTER=disabled

# Workflow proof gate (disabled; no engine implemented)
RIGHTJOB_WORKFLOW_ENABLED=false
RIGHTJOB_WORKFLOW_ADAPTER=disabled

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
